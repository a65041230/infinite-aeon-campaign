# Doubt-Driven 鑑別工作台 (/ddx) — set these in Vercel: Project → Settings → Environment Variables.
# Set ONE provider key. Claude is used when ANTHROPIC_API_KEY is set; otherwise DeepSeek.
# Never commit real values.
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# Force a provider when both keys are set: anthropic | deepseek
# DDX_PROVIDER=
# Access code(s) the shared link carries as /ddx?k=<code>. Comma-separate to issue several.
DDX_ACCESS_KEY=
# Optional: model (default claude-opus-5-5 for Claude, deepseek-flash for DeepSeek).
# DDX_MODEL=claude-opus-5-5
