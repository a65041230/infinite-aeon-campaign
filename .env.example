# Doubt-Driven 鑑別工作台 (/ddx) — set these in Vercel: Project → Settings → Environment Variables.
# Set ONE provider key. Claude is used when ANTHROPIC_API_KEY is set; otherwise DeepSeek.
# Never commit real values.
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# An OpenRouter key (sk-or-...) also works here, or as OPENROUTER_API_KEY; the site then
# calls DeepSeek through OpenRouter, only via hosts that don't store or train on data.
# Force a provider when both keys are set: anthropic | deepseek
# DDX_PROVIDER=
# Access code(s) the shared link carries as /ddx?k=<code>. Comma-separate to issue several.
DDX_ACCESS_KEY=
# Or open the site to anyone with the address (no code). Cost is then capped only by the provider's spend limit.
# DDX_PUBLIC=1
# Optional: model (default claude-opus-5-5 for Claude, deepseek-flash for DeepSeek,
# deepseek/deepseek-v4.1-flash through OpenRouter).
# With an OpenRouter key, anthropic/claude-opus-5.5 runs Claude through OpenRouter's Messages API.
# DDX_MODEL=claude-opus-5-5
