{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "agent": {
    "plan": { "model": "deepseek/deepseek-v4-pro" }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets/**": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npx tsc*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "sudo*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "npm publish*": "deny"
    }
  }
}
